# Optional branding, read at build time. Copy to .env and edit.
# Shown in the browser tab title ("Link Checker · <name>") and as the logo's alt text.
VITE_BRAND_NAME=
# Logo in the top bar and favicon. Put your file in web/public/brand/ (gitignored)
# and point this at it, e.g. /brand/logo.svg. Empty uses the default /logo.svg.
VITE_LOGO_URL=
# Source code link in the Help dialog. Empty uses the upstream repo.
VITE_REPO_URL=
